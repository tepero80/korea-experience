{
  "name": "korea-experience",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check && tsx scripts/generate-search-index.ts && tsx scripts/generate-routing.ts && tsx scripts/validate-cards.ts",
    "build": "next build",
    "postbuild": "tsx scripts/verify-export.ts && tsx scripts/audit-export-links.ts && node scripts/export-budget.mjs",
    "start": "node scripts/preview.mjs",
    "check": "node scripts/sync-design.mjs --check && tsc --noEmit && tsx scripts/validate-content.ts && tsx scripts/validate-media.ts && tsx --test tests/*.test.ts",
    "sync:design": "node scripts/sync-design.mjs",
    "audit:experience": "tsx scripts/audit-experience.ts",
    "test:browser": "playwright test",
    "check:community": "npm --prefix workers/community run check && npm --prefix workers/community run test",
    "health": "tsx scripts/health-check.ts",
    "metrics": "node --env-file=.env.local --import tsx scripts/fetch-metrics.ts",
    "reporting:authorize": "tsx scripts/authorize-reporting.ts",
    "reporting:refresh": "tsx scripts/authorize-reporting.ts --refresh-check",
    "inspect:urls": "tsx scripts/inspect-urls.ts",
    "generate:cards": "tsx scripts/generate-cards.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "3.0.1",
    "image-size": "^2.0.4",
    "leaflet": "^1.9.4",
    "next": "^16.4.3",
    "next-mdx-remote": "^6.0.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "google-auth-library": "11.3.2",
    "jsqr": "1.4.0",
    "lighthouse": "13.5.0",
    "parse5": "8.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "fflate": "0.8.3"
  }
}
