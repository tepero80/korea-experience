{
  "name": "korea-experience-community",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "check": "node ../../scripts/sync-design.mjs --check && tsc --noEmit && node --import tsx scripts/auth-schema.ts --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply korea-experience-community --local",
    "db:remote": "wrangler d1 migrations apply korea-experience-community --remote",
    "auth:schema": "node --import tsx scripts/auth-schema.ts",
    "probe:staging": "node --import tsx scripts/staging-probe.ts",
    "restore:staging": "node --import tsx scripts/staging-restore.ts",
    "backup:production": "node --import tsx scripts/backup-remote.ts production"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "wrangler": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
